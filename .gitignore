/target
**/*.rs.bk
.DS_Store

# HDRIs — bring your own (Poly Haven CC0 recommended). Keep the folder,
# skip the heavy binaries.
/assets/hdri/*.hdr
/assets/hdri/*.exr

# Default mesh — user-provided. Drop default.usda (or any .usd/.usda) in
# assets/default_mesh/ and the viewport will open it instead of the cube.
/assets/default_mesh/*.usd
/assets/default_mesh/*.usda
/assets/default_mesh/*.usdc

# Stencils + displacement library — bring your own (Poly Haven CC0 is
# great). Auto-imported into the bottom asset browser on startup.
/assets/stencils/*.png
/assets/stencils/*.jpg
/assets/stencils/*.jpeg
/assets/stencils/*.exr
/assets/displacement/*.png
/assets/displacement/*.jpg
/assets/displacement/*.jpeg
/assets/displacement/*.exr

# Editor
.vscode/
.idea/
*.swp
*.swo
