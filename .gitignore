/target
**/*.rs.bk
.DS_Store

# Local-dev source overrides for rust-usd / hydra-rs ([patch.crates-io]
# pointing at ../rust-usd) — machine-specific, see README.md.
/.cargo/config.toml

# HDRIs — bring your own (Poly Haven CC0 recommended). Keep the folder,
# skip the heavy binaries.
/assets/hdri/*.hdr
/assets/hdri/*.exr
!/assets/hdri/forge_studio_4x2.hdr
# 3Delight regenerates `.auto.tdl` texture caches next to the source
# .hdr / .exr the first time hdNSI samples them. Build artifacts.
/assets/hdri/*.tdl
/assets/**/*.auto.tdl

# Default mesh — user-provided. Drop default.usda (or any .usd/.usda) in
# assets/default_mesh/ and the viewport will open it instead of the cube.
/assets/default_mesh/*.usd
/assets/default_mesh/*.usda
/assets/default_mesh/*.usdc
!/assets/default_mesh/default.usda
# Nested asset folders (Poly Haven downloads etc.) under default_mesh/ —
# these hold multi-gigabyte EXR textures and USDs per asset; never commit.
/assets/default_mesh/*/

# Stencils + displacement library — bring your own (Poly Haven CC0 is
# great). Auto-imported into the bottom asset browser on startup.
/assets/stencils/*.png
/assets/stencils/*.jpg
/assets/stencils/*.jpeg
/assets/stencils/*.exr
!/assets/stencils/forge_soft_round.png
/assets/displacement/*.png
/assets/displacement/*.jpg
/assets/displacement/*.jpeg
/assets/displacement/*.exr
!/assets/displacement/forge_checker_height.png

# Editor
.vscode/
.idea/
*.swp
*.swo

# Local Houdini HDA tooling — mock lookdev-publish workflow, built/run
# from Houdini's hython, not part of the forge-paint app build.
/tools/houdini/
