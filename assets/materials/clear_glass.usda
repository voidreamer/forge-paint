#usda 1.0
(
    defaultPrim = "Material"
    doc = "Bundled UsdPreviewSurface starter material — clear glass via opacity + IOR."
)

def Material "Material"
{
    token outputs:surface.connect = </Material/Surface.outputs:surface>

    def Shader "Surface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
        float inputs:metallic = 0.0
        float inputs:roughness = 0.02
        float inputs:opacity = 0.15
        float inputs:ior = 1.5
        token outputs:surface
    }
}
