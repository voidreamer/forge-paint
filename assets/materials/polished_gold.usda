#usda 1.0
(
    defaultPrim = "Material"
    doc = "Bundled UsdPreviewSurface starter material — polished gold (sRGB-ish base colour)."
)

def Material "Material"
{
    token outputs:surface.connect = </Material/Surface.outputs:surface>

    def Shader "Surface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (1.0, 0.78, 0.34)
        float inputs:metallic = 1.0
        float inputs:roughness = 0.12
        token outputs:surface
    }
}
