#usda 1.0
(
    defaultPrim = "Material"
    doc = "Bundled UsdPreviewSurface starter material — anodised blue metal."
)

def Material "Material"
{
    token outputs:surface.connect = </Material/Surface.outputs:surface>

    def Shader "Surface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.12, 0.30, 0.65)
        float inputs:metallic = 1.0
        float inputs:roughness = 0.22
        token outputs:surface
    }
}
