#usda 1.0
(
    defaultPrim = "Material"
    doc = "Bundled 3Delight (OSL) starter — chrome via _3DelightMaterial. 3Delight-specific shader IDs only resolve correctly in hdNSI; non-NSI delegates (Storm, Arnold) will warn about an unrecognised `info:id` and fall back to the default white surface. The pane's `3Delight (OSL)` chip filter is what gates this kind from the universal ones."
)

def Material "Material"
{
    # 3Delight binds via the `nsi:surface` terminal — same pattern
    # MaterialX uses for its `mtlx:surface`. The bare `surface`
    # connection stays as a fallback so non-NSI delegates render
    # *something* rather than nothing.
    token outputs:nsi:surface.connect = </Material/Surface.outputs:surface>
    token outputs:surface.connect = </Material/Surface.outputs:surface>

    def Shader "Surface"
    {
        uniform token info:id = "_3DelightMaterial"

        # _3DelightMaterial's input naming differs from both
        # UsdPreviewSurface and MaterialX standard_surface — they're
        # i_-prefixed by 3Delight convention. The full input list
        # lives in /Applications/3Delight/maya/osl/_3DelightMaterial
        # (oslc -h to inspect); these are the ones a chrome material
        # touches.
        color3f inputs:i_color = (0.92, 0.93, 0.94)
        float inputs:roughness = 0.08
        float inputs:metallic = 1.0
        float inputs:specular_level = 1.0
        float inputs:anisotropy = 0.0

        token outputs:surface
    }
}
