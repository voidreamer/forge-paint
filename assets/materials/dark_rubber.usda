#usda 1.0
(
    defaultPrim = "Material"
    doc = "Bundled UsdPreviewSurface starter material — dark rubber, rough dielectric."
)

def Material "Material"
{
    token outputs:surface.connect = </Material/Surface.outputs:surface>

    def Shader "Surface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.05, 0.05, 0.06)
        float inputs:metallic = 0.0
        float inputs:roughness = 0.85
        float inputs:specular = 0.3
        token outputs:surface
    }
}
