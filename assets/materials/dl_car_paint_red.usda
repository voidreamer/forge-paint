#usda 1.0
(
    defaultPrim = "Material"
    doc = "Bundled 3Delight Car Paint (dlCarPaint) — red metallic flake paint. dlCarPaint composites a metallic base + procedural sparkle flakes + an implicit clearcoat in one shader, which is why automotive looks rarely need a layered material on top."
)

def Material "Material"
{
    token outputs:nsi:surface.connect = </Material/Surface.outputs:surface>
    token outputs:surface.connect = </Material/Surface.outputs:surface>

    def Shader "Surface"
    {
        uniform token info:id = "dlCarPaint"

        color3f inputs:i_color = (0.55, 0.05, 0.05)
        float inputs:diffuse_roughness = 0.35

        color3f inputs:specular_color = (1.0, 0.4, 0.4)
        float inputs:specular_level = 0.7
        float inputs:specular_roughness_1 = 0.05
        float inputs:specular_roughness_2 = 0.30
        float inputs:specular_balance = 0.5
        float inputs:metallic = 0.85

        float inputs:flake_weight = 0.6
        float inputs:flake_density = 0.7
        color3f inputs:flake_color = (1.0, 0.4, 0.3)
        float inputs:flake_roughness = 0.25
        float inputs:flake_scale = 0.25
        int inputs:flake_layers = 3

        token outputs:surface
    }
}
